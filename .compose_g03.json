", "concept_options": [{"id": "c1", "title": "Vì Sao Người Tiền Sử Rảnh Hơn Bạn?", "hook": "Sáng nay, một cái máy hét vào mặt bạn cho tới khi bạn dậy. Tổ tiên bạn thì tự dậy, vươn vai, và hỏi: hôm nay làm gì nhỉ?", "narrative_structure": "myth_busting", "visual_approach": "Playbook người que (stick-savanna): nét mực đen hơi rung, đầu tròn phẳng, nền phong cảnh vẽ tay nhạt; nhân vật dẫn chuyện của người dùng (tóc nâu bù xù, áo da thú) xuyên suốt; cảnh chia đôi người văn phòng khổ sở với người tiền sử ung dung; khoảng một nửa cảnh là clip Veo.", "suggested_playbook": "người que", "target_audience": "Khán giả phổ thông Việt Nam thích lịch sử loài người, cơ thể, đời sống hiện đại", "target_platform": "youtube", "target_duration_seconds": 120, "key_points": ["Hai bộ xương: người săn bắt cao khỏe, nông dân đầu tiên thấp hơn khoảng 4 cm và sâu răng", "Richard Lee đo: người Ju/'hoansi chỉ cần 12-19 giờ mỗi tuần để kiếm ăn", "Buổi chiều rảnh làm đồ đẹp: hạt vỏ ốc 75.000 năm, sáo xương kền kền 40.000 năm", "Ban đêm bên lửa 81% là kể chuyện (Wiessner 2014), ngủ hai giấc", "Nông nghiệp là cái bẫy: nhiều lương thực, nhiều người, nhiều việc, không quay lại được"], "core_message": "Thời gian rảnh không bị ai cướp trong một đêm; nó bị đổi dần lấy hạt giống, qua từng thế hệ.", "cta": "Đăng ký để xem tiếp cơ thể bạn còn giữ gì từ tổ tiên.", "tone": "hài khô, ấm, so sánh tiền sử với đời sống hiện đại", "grounded_in": ["Lee 1966", "Wiessner 2014", "Discover skeletal data", "Blombos", "Hohle Fels", "Ekirch"], "why_this_works": "Bám đúng xương sống nội dung của video tham khảo (người dùng muốn giống nhất có thể, như cùng tác giả), đảo ngược hiểu lầm 'đời tiền sử khổ cực' bằng số đo của Lee và bằng chứng xương."}, {"id": "c2", "title": "Hạt Giống Nào Đã Lấy Mất Thời Gian Của Bạn?", "hook": "Mười nghìn năm trước, ai đó gieo một hạt giống. Và vì thế sáng nay bạn phải dậy lúc 6 giờ.", "narrative_structure": "story", "visual_approach": "Cùng playbook người que; kể ngược từ báo thức về hạt giống đầu tiên.", "suggested_playbook": "người que", "target_platform": "youtube", "target_duration_seconds": 120, "core_message": "Nông nghiệp là cái bẫy dân số.", "why_this_works": "Tập trung một cơ chế duy nhất (bẫy nông nghiệp), dựa trên bằng chứng xương."}, {"id": "c3", "title": "81% Chuyện Bên Lửa Là Gì?", "hook": "Ban ngày tổ tiên bạn nói chuyện săn bắn. Ban đêm, 81% là chuyện kể.", "narrative_structure": "data_narrative", "visual_approach": "Cùng playbook người que, tập trung cảnh đêm bên lửa.", "suggested_playbook": "người que", "target_platform": "youtube", "target_duration_seconds": 120, "core_message": "Văn hóa sinh ra trong giờ rảnh.", "why_this_works": "Dữ liệu Wiessner 2014 bất ngờ, ít video tiếng Việt nói tới."}], "selected_concept": {"concept_id": "c1", "rationale": "Người dùng yêu cầu giống video tham khảo nhất có thể, như cùng một tác giả; c1 giữ cùng chủ đề, cùng móc mở đầu và cùng mạch nội dung, nén vào 2 phút theo công thức playbook.", "modifications": ["Rút từ 11 phút xuống 2 phút: bỏ đoạn săn đuổi dài, gộp Hadza/Ache/Martu thành một câu"]}, "production_plan": {"pipeline": "animated-explainer", "playbook": "người que", "stages": [{"stage": "research", "tools": [{"tool_name": "transcript_fetcher", "role": "Lấy lời video tham khảo", "provider": "youtube-transcript-api", "available": true, "estimated_cost_usd": 0}], "approach": "Chỉ đọc nội dung (playbook khóa look + motion), kiểm chứng số liệu bằng web search"}, {"stage": "script", "tools": [], "approach": "Khoảng 505 từ, 10 phần, theo narrative của playbook"}, {"stage": "narration", "tools": [{"tool_name": "ai33_tts", "role": "Giọng đọc", "provider": "ai33", "available": true, "estimated_cost_usd": 0.1, "why_this_provider": "Khóa từ playbook: Vbee Minh Quân, speed 1.15"}, {"tool_name": "audio_qc", "role": "Đo nhịp", "provider": "ffmpeg", "available": true, "estimated_cost_usd": 0}], "approach": "TTS từng phần, đo thời lượng"}, {"stage": "scene_plan", "tools": [], "approach": "Khoảng 45 cảnh theo m