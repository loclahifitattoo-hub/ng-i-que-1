          "text": "T\u1ed1i nay, b\u1ea1n l\u1ea1i t\u1ef1 tay h\u1eb9n n\u00f3 h\u00e9t ti\u1ebfp.",
          "start_seconds": 5.81,
          "end_seconds": 8.09,
          "hold_seconds": 2.28,
          "cut_pause_seconds": 0.4,
          "in_band": true
        },
        {
          "beat_id": "b004",
          "section_id": "s1",
          "word_start": 38,
          "word_end": 45,
          "text": "Gi\u1edd, tua ng\u01b0\u1ee3c n\u0103m m\u01b0\u01a1i ngh\u00ecn n\u0103m.",
          "start_seconds": 8.09,
          "end_seconds": 10.265,
          "hold_seconds": 2.175,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b005",
          "section_id": "s2",
          "word_start": 0,
          "word_end": 10,
          "text": "M\u1ed9t ng\u01b0\u1eddi \u0111\u00e0n \u00f4ng t\u1ef1 th\u1ee9c d\u1eady trong n\u1eafng s\u1edbm.",
          "start_seconds": 10.265,
          "end_seconds": 12.455,
          "hold_seconds": 2.19,
          "cut_pause_seconds": 0.48,
          "in_band": true
        },
        {
          "beat_id": "b006",
          "section_id": "s2",
          "word_start": 10,
          "word_end": 16,
          "text": "Kh\u00f4ng b\u00e1o th\u1ee9c, kh\u00f4ng l\u1ecbch h\u1ecdp.",
          "start_seconds": 12.455,
          "end_seconds": 14.134,
          "hold_seconds": 1.679,
          "cut_pause_seconds": 0.419,
          "in_band": true
        },
        {
          "beat_id": "b007",
          "section_id": "s2",
          "word_start": 16,
          "word_end": 20,
          "text": "Anh ta v\u01b0\u01a1n vai,",
          "start_seconds": 14.134,
          "end_seconds": 15.215,
          "hold_seconds": 1.081,
          "cut_pause_seconds": 0.4,
          "in_band": true
        },
        {
          "beat_id": "b008",
          "section_id": "s2",
          "word_start": 20,
          "word_end": 32,
          "text": "r\u1ed3i h\u1ecfi m\u1ed9t c\u00e2u b\u1ea1n ch\u01b0a bao gi\u1edd \u0111\u1ee7 r\u1ea3nh \u0111\u1ec3 h\u1ecfi:",
          "start_seconds": 15.215,
          "end_seconds": 17.525,
          "hold_seconds": 2.31,
          "cut_pause_seconds": 0.0,
          "in_band": true
        },
        {
          "beat_id": "b009",
          "section_id": "s2",
          "word_start": 32,
          "word_end": 38,
          "text": "h\u00f4m nay m\u00ecnh l\u00e0m g\u00ec nh\u1ec9?",
          "start_seconds": 17.525,
          "end_seconds": 19.095,
          "hold_seconds": 1.57,
          "cut_pause_seconds": 0.46,
          "in_band": true
        },
        {
          "beat_id": "b010",
          "section_id": "s2",
          "word_start": 38,
          "word_end": 48,
          "text": "Nh\u01b0ng khoan, \u0111\u1eddi ti\u1ec1n s\u1eed ch\u1eb3ng ph\u1ea3i kh\u1ed5 l\u1eafm sao?",
          "start_seconds": 19.095,
          "end_seconds": 21.94,
          "hold_seconds": 2.845,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b011",
          "section_id": "s3",
          "word_start": 0,
          "word_end": 12,
          "text": "C\u00e1c nh\u00e0 kh\u1ea3o c\u1ed5 \u0111\u00e0o l\u00ean hai b\u1ed9 x\u01b0\u01a1ng c\u00f9ng m\u1ed9t v\u00f9ng.",
          "start_seconds": 21.94,
          "end_seconds": 24.37,
          "hold_seconds": 2.43,
          "cut_pause_seconds": 0.42,
          "in_band": true
        },
        {
          "beat_id": "b012",
          "section_id": "s3",
          "word_start": 12,
          "word_end": 19,
          "text": "M\u1ed9t b\u1ed9 cao, x\u01b0\u01a1ng d\u00e0y, r\u0103ng ch\u1eafc.",
          "start_seconds": 24.37,
          "end_seconds": 26.65,
          "hold_seconds": 2.28,
          "cut_pause_seconds": 0.42,
          "in_band": true
        },
        {
          "beat_id": "b013",
          "section_id": "s3",
          "word_start": 19,
          "word_end": 28,
          "text": "B\u1ed9 kia r\u0103ng s\u00e2u, c\u1ed9t s\u1ed1ng m\u00f2n, ch\u1ebft s\u1edbm.",
          "start_seconds": 26.65,
          "end_seconds": 29.25,
          "hold_seconds": 2.6,
          "cut_pause_seconds": 0.46,
          "in_band": true
        },
        {
          "beat_id": "b014",
          "section_id": "s3",
          "word_start": 28,
          "word_end": 35,
          "text": "\u0110o\u00e1n xem ai l\u00e0 ng\u01b0\u1eddi ti\u1ec1n s\u1eed?",
          "start_seconds": 29.25,
          "end_seconds": 30.91,
          "hold_seconds": 1.66,
          "cut_pause_seconds": 0.42,
          "in_band": true
        },
        {
          "beat_id": "b015",
          "section_id": "s3",
          "word_start": 35,
          "word_end": 42,
          "text": "B\u1ed9 x\u01b0\u01a1ng kh\u1ecfe l\u00e0 ng\u01b0\u1eddi s\u0103n b\u1eaft.",
          "start_seconds": 30.91,
          "end_seconds": 32.47,
          "hold_seconds": 1.56,
          "cut_pause_seconds": 0.4,
          "in_band": true
        },
        {
          "beat_id": "b016",
          "section_id": "s3",
          "word_start": 42,
          "word_end": 50,
          "text": "B\u1ed9 x\u01b0\u01a1ng t\u00e0n t\u1ea1 l\u00e0 ng\u01b0\u1eddi n\u00f4ng d\u00e2n,",
          "start_seconds": 32.47,
          "end_seconds": 34.13,
          "hold_seconds": 1.66,
          "cut_pause_seconds": 0.34,
          "in_band": true
        },
        {
          "beat_id": "b017",
          "section_id": "s3",
          "word_start": 50,
          "word_end": 57,
          "text": "th\u1eddi \u0111\u1ea1i ta g\u1ecdi l\u00e0 ti\u1ebfn b\u1ed9.",
          "start_seconds": 34.13,
          "end_seconds": 36.07,
          "hold_seconds": 1.94,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b018",
          "section_id": "s4",
          "word_start": 0,
          "word_end": 6,
          "text": "V\u1eady h\u1ecd l\u00e0m g\u00ec c\u1ea3 ng\u00e0y?",
          "start_seconds": 36.07,
          "end_seconds": 37.58,
          "hold_seconds": 1.51,
          "cut_pause_seconds": 0.48,
          "in_band": true
        },
        {
          "beat_id": "b019",
          "section_id": "s4",
          "word_start": 6,
          "word_end": 15,
          "text": "Nh\u1eefng n\u0103m s\u00e1u m\u01b0\u01a1i, nh\u00e0 nh\u00e2n h\u1ecdc Richard Lee",
          "start_seconds": 37.58,
          "end_seconds": 39.88,
          "hold_seconds": 2.3,
          "cut_pause_seconds": 0.32,
          "in_band": true
        },
        {
          "beat_id": "b020",
          "section_id": "s4",
          "word_start": 15,
          "word_end": 27,
          "text": "v\u00e0o sa m\u1ea1c Kalahari v\u1edbi s\u1ed5 tay v\u00e0 \u0111\u1ed3ng h\u1ed3 b\u1ea5m gi\u1edd,",
          "start_seconds": 39.88,
          "end_seconds": 42.98,
          "hold_seconds": 3.1,
          "cut_pause_seconds": 0.42,
          "in_band": true
        },
        {
          "beat_id": "b021",
          "section_id": "s4",
          "word_start": 27,
          "word_end": 35,
          "text": "\u0111\u1ebfm t\u1eebng gi\u1edd l\u00e0m vi\u1ec7c c\u1ee7a ng\u01b0\u1eddi San.",
          "start_seconds": 42.98,
          "end_seconds": 44.86,
          "hold_seconds": 1.88,
          "cut_pause_seconds": 0.48,
          "in_band": true
        },
        {
          "beat_id": "b022",
          "section_id": "s4",
          "word_start": 35,
          "word_end": 43,
          "text": "K\u1ebft qu\u1ea3: kho\u1ea3ng m\u01b0\u1eddi b\u1ea3y gi\u1edd ki\u1ebfm \u0103n.",
          "start_seconds": 44.86,
          "end_seconds": 47.08,
          "hold_seconds": 2.22,
          "cut_pause_seconds": 0.44,
          "in_band": true
        },
        {
          "beat_id": "b023",
          "section_id": "s4",
          "word_start": 43,
          "word_end": 50,
          "text": "Kh\u00f4ng ph\u1ea3i m\u1ed7i ng\u00e0y, m\u00e0 c\u1ea3 tu\u1ea7n.",
          "start_seconds": 47.08,
          "end_seconds": 49.261,
          "hold_seconds": 2.181,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b024",
          "section_id": "s5",
          "word_start": 0,
          "word_end": 6,
          "text": "Ch\u1ec9 l\u00e0 m\u1ed9t nh\u00f3m may m\u1eafn?",
          "start_seconds": 49.261,
          "end_seconds": 50.551,
          "hold_seconds": 1.29,
          "cut_pause_seconds": 0.4,
          "in_band": true
        },
        {
          "beat_id": "b025",
          "section_id": "s5",
          "word_start": 6,
          "word_end": 14,
          "text": "C\u00e1c nh\u00e0 khoa h\u1ecdc \u0111\u1ebfm l\u1ea1i \u1edf Tanzania,",
          "start_seconds": 50.551,
          "end_seconds": 52.451,
          "hold_seconds": 1.9,
          "cut_pause_seconds": 0.36,
          "in_band": true
        },
        {
          "beat_id": "b026",
          "section_id": "s5",
          "word_start": 14,
          "word_end": 18,
          "text": "Paraguay, r\u1ed3i n\u01b0\u1edbc \u00dac.",
          "start_seconds": 52.451,
          "end_seconds": 54.171,
          "hold_seconds": 1.72,
          "cut_pause_seconds": 0.42,
          "in_band": true
        },
        {
          "beat_id": "b027",
          "section_id": "s5",
          "word_start": 18,
          "word_end": 30,
          "text": "L\u1ea7n n\u00e0o c\u0169ng ra m\u01b0\u1eddi l\u0103m \u0111\u1ebfn hai m\u01b0\u01a1i gi\u1edd m\u1ed9t tu\u1ea7n.",
          "start_seconds": 54.171,
          "end_seconds": 56.491,
          "hold_seconds": 2.32,
          "cut_pause_seconds": 0.5,
          "in_band": true
        },
        {
          "beat_id": "b028",
          "section_id": "s5",
          "word_start": 30,
          "word_end": 37,
          "text": "V\u1eady th\u1eddi gian c\u00f2n l\u1ea1i \u0111i \u0111\u00e2u?",
          "start_seconds": 56.491,
          "end_seconds": 58.309,
          "hold_seconds": 1.818,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b029",
          "section_id": "s6",
          "word_start": 0,
          "word_end": 8,
          "text": "Bu\u1ed5i chi\u1ec1u, ng\u01b0\u1eddi ta ng\u1ed3i d\u01b0\u1edbi b\u00f3ng c\u00e2y,",
          "start_seconds": 58.309,
          "end_seconds": 60.279,
          "hold_seconds": 1.97,
          "cut_pause_seconds": 0.3,
          "in_band": true
        },
        {
          "beat_id": "b030",
          "section_id": "s6",
          "word_start": 8,
          "word_end": 14,
          "text": "t\u00e1n chuy\u1ec7n, b\u1eaft ch\u1ea5y cho nhau.",
          "start_seconds": 60.279,
          "end_seconds": 61.899,
          "hold_seconds": 1.62,
          "cut_pause_seconds": 0.4,
          "in_band": true
        },
        {
          "beat_id": "b031",
          "section_id": "s6",
          "word_start": 14,
          "word_end": 22,
          "text": "C\u00f3 ng\u01b0\u1eddi khoan v\u1ecf \u1ed1c x\u00e2u v\u00f2ng c\u1ed5,",
          "start_seconds": 61.899,
          "end_seconds": 63.439,
          "hold_seconds": 1.54,
          "cut_pause_seconds": 0.3,
          "in_band": true
        },
        {
          "beat_id": "b032",
          "section_id": "s6",
          "word_start": 22,
          "word_end": 35,
          "text": "lo\u1ea1i h\u1ea1t t\u00ecm th\u1ea5y \u1edf Nam Phi, b\u1ea3y m\u01b0\u01a1i l\u0103m ngh\u00ecn n\u0103m tu\u1ed5i.",
          "start_seconds": 63.439,
          "end_seconds": 66.159,
          "hold_seconds": 2.72,
          "cut_pause_seconds": 0.44,
          "in_band": true
        },
        {
          "beat_id": "b033",
          "section_id": "s6",
          "word_start": 35,
          "word_end": 43,
          "text": "\u1ede \u0110\u1ee9c, m\u1ed9t c\u00e2y s\u00e1o x\u01b0\u01a1ng k\u1ec1n k\u1ec1n,",
          "start_seconds": 66.159,
          "end_seconds": 68.079,
          "hold_seconds": 1.92,
          "cut_pause_seconds": 0.32,
          "in_band": true
        },
        {
          "beat_id": "b034",
          "section_id": "s6",
          "word_start": 43,
          "word_end": 48,
          "text": "b\u1ed1n m\u01b0\u01a1i ngh\u00ecn n\u0103m tu\u1ed5i.",
          "start_seconds": 68.079,
          "end_seconds": 69.279,
          "hold_seconds": 1.2,
          "cut_pause_seconds": 0.46,
          "in_band": true
        },
        {
          "beat_id": "b035",
          "section_id": "s6",
          "word_start": 48,
          "word_end": 58,
          "text": "Ngh\u0129a l\u00e0 c\u00f3 ng\u01b0\u1eddi \u0111\u1ee7 r\u1ea3nh \u0111\u1ec3 t\u1eadp th\u1ed5i s\u00e1o.",
          "start_seconds": 69.279,
          "end_seconds": 71.63,
          "hold_seconds": 2.351,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b036",
          "section_id": "s7",
          "word_start": 0,
          "word_end": 6,
          "text": "Nh\u01b0ng gi\u1edd r\u1ea3nh \u0111\u00f3 kh\u00f4ng ph\u00ed.",
          "start_seconds": 71.63,
          "end_seconds": 73.18,
          "hold_seconds": 1.55,
          "cut_pause_seconds": 0.44,
          "in_band": true
        },
        {
          "beat_id": "b037",
          "section_id": "s7",
          "word_start": 6,
          "word_end": 14,
          "text": "\u1ede th\u1ebf gi\u1edbi kh\u00f4ng ti\u1ec1n, kh\u00f4ng b\u1ea3o hi\u1ec3m,",
          "start_seconds": 73.18,
          "end_seconds": 75.12,
          "hold_seconds": 1.94,
          "cut_pause_seconds": 0.38,
          "in_band": true
        },
        {
          "beat_id": "b038",
          "section_id": "s7",
          "word_start": 14,
          "word_end": 26,
          "text": "khi b\u1ea1n g\u00e3y ch\u00e2n, th\u1ee9 duy nh\u1ea5t nu\u00f4i b\u1ea1n l\u00e0 ng\u01b0\u1eddi kh\u00e1c.",
          "start_seconds": 75.12,
          "end_seconds": 77.92,
          "hold_seconds": 2.8,
          "cut_pause_seconds": 0.42,
          "in_band": true
        },
        {
          "beat_id": "b039",
          "section_id": "s7",
          "word_start": 26,
          "word_end": 31,
          "text": "\u0110\u01b0\u1ee3c qu\u00fd th\u00ec c\u00f3 \u0103n.",
          "start_seconds": 77.92,
          "end_seconds": 79.1,
          "hold_seconds": 1.18,
          "cut_pause_seconds": 0.36,
          "in_band": true
        },
        {
          "beat_id": "b040",
          "section_id": "s7",
          "word_start": 31,
          "word_end": 35,
          "text": "B\u1ecb gh\u00e9t th\u00ec nh\u1ecbn.",
          "start_seconds": 79.1,
          "end_seconds": 80.16,
          "hold_seconds": 1.06,
          "cut_pause_seconds": 0.34,
          "in_band": true
        },
        {
          "beat_id": "b041",
          "section_id": "s7",
          "word_start": 35,
          "word_end": 42,
          "text": "T\u00e1n g\u1eabu ch\u00ednh l\u00e0 qu\u1ef9 l\u01b0\u01a1ng h\u01b0u.",
          "start_seconds": 80.16,
          "end_seconds": 82.26,
          "hold_seconds": 2.1,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b042",
          "section_id": "s8",
          "word_start": 0,
          "word_end": 4,
          "text": "R\u1ed3i m\u1eb7t tr\u1eddi l\u1eb7n.",
          "start_seconds": 82.26,
          "end_seconds": 83.41,
          "hold_seconds": 1.15,
          "cut_pause_seconds": 0.38,
          "in_band": true
        },
        {
          "beat_id": "b043",
          "section_id": "s8",
          "word_start": 4,
          "word_end": 16,
          "text": "Ban ng\u00e0y ng\u01b0\u1eddi San b\u00e0n chuy\u1ec7n s\u0103n b\u1eafn v\u00e0 n\u00f3i x\u1ea5u nhau.",
          "start_seconds": 83.41,
          "end_seconds": 85.89,
          "hold_seconds": 2.48,
          "cut_pause_seconds": 0.46,
          "in_band": true
        },
        {
          "beat_id": "b044",
          "section_id": "s8",
          "word_start": 16,
          "word_end": 29,
          "text": "Nh\u01b0ng \u0111\u00eam b\u00ean \u0111\u1ed1ng l\u1eeda, t\u00e1m m\u01b0\u01a1i m\u1ed1t ph\u1ea7n tr\u0103m l\u00e0 k\u1ec3 chuy\u1ec7n:",
          "start_seconds": 85.89,
          "end_seconds": 88.53,
          "hold_seconds": 2.64,
          "cut_pause_seconds": 0.34,
          "in_band": true
        },
        {
          "beat_id": "b045",
          "section_id": "s8",
          "word_start": 29,
          "word_end": 35,
          "text": "th\u1ea7n linh, t\u1ed5 ti\u00ean, chuy\u1ec7n c\u01b0\u1eddi.",
          "start_seconds": 88.53,
          "end_seconds": 90.51,
          "hold_seconds": 1.98,
          "cut_pause_seconds": 0.34,
          "in_band": true
        },
        {
          "beat_id": "b046",
          "section_id": "s8",
          "word_start": 35,
          "word_end": 45,
          "text": "R\u1ed3i h\u1ecd ng\u1ee7 hai gi\u1ea5c, th\u1ee9c gi\u1eefa \u0111\u00eam m\u1ed9t l\u00fac.",
          "start_seconds": 90.51,
          "end_seconds": 92.73,
          "hold_seconds": 2.22,
          "cut_pause_seconds": 0.4,
          "in_band": true
        },
        {
          "beat_id": "b047",
          "section_id": "s8",
          "word_start": 45,
          "word_end": 57,
          "text": "B\u1ea1n t\u1ec9nh l\u00fac hai gi\u1edd s\u00e1ng v\u00e0 g\u1ecdi \u0111\u00f3 l\u00e0 m\u1ea5t ng\u1ee7.",
          "start_seconds": 92.73,
          "end_seconds": 95.607,
          "hold_seconds": 2.877,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b048",
          "section_id": "s9",
          "word_start": 0,
          "word_end": 11,
          "text": "Nh\u01b0ng m\u01b0\u1eddi ngh\u00ecn n\u0103m tr\u01b0\u1edbc, ai \u0111\u00f3 gieo m\u1ed9t h\u1ea1t gi\u1ed1ng.",
          "start_seconds": 95.607,
          "end_seconds": 98.117,
          "hold_seconds": 2.51,
          "cut_pause_seconds": 0.38,
          "in_band": true
        },
        {
          "beat_id": "b049",
          "section_id": "s9",
          "word_start": 11,
          "word_end": 20,
          "text": "Nhi\u1ec1u l\u01b0\u01a1ng th\u1ef1c th\u00ec nhi\u1ec1u em b\u00e9 s\u1ed1ng s\u00f3t.",
          "start_seconds": 98.117,
          "end_seconds": 99.977,
          "hold_seconds": 1.86,
          "cut_pause_seconds": 0.32,
          "in_band": true
        },
        {
          "beat_id": "b050",
          "section_id": "s9",
          "word_start": 20,
          "word_end": 26,
          "text": "Nhi\u1ec1u ng\u01b0\u1eddi th\u00ec c\u1ea7n nhi\u1ec1u ru\u1ed9ng.",
          "start_seconds": 99.977,
          "end_seconds": 101.377,
          "hold_seconds": 1.4,
          "cut_pause_seconds": 0.32,
          "in_band": true
        },
        {
          "beat_id": "b051",
          "section_id": "s9",
          "word_start": 26,
          "word_end": 31,
          "text": "Nhi\u1ec1u ru\u1ed9ng th\u00ec nhi\u1ec1u vi\u1ec7c.",
          "start_seconds": 101.377,
          "end_seconds": 102.677,
          "hold_seconds": 1.3,
          "cut_pause_seconds": 0.34,
          "in_band": true
        },
        {
          "beat_id": "b052",
          "section_id": "s9",
          "word_start": 31,
          "word_end": 45,
          "text": "Khi b\u1ed9 t\u1ed9c qu\u00e1 \u0111\u00f4ng \u0111\u1ec3 s\u0103n b\u1eaft nu\u00f4i n\u1ed5i, c\u00e1nh c\u1eeda \u0111\u00f3ng s\u1eadp.",
          "start_seconds": 102.677,
          "end_seconds": 105.597,
          "hold_seconds": 2.92,
          "cut_pause_seconds": 0.38,
          "in_band": true
        },
        {
          "beat_id": "b053",
          "section_id": "s9",
          "word_start": 45,
          "word_end": 53,
          "text": "C\u00e0y, gieo, g\u1eb7t, n\u0103m n\u00e0y qua n\u0103m kh\u00e1c.",
          "start_seconds": 105.597,
          "end_seconds": 108.217,
          "hold_seconds": 2.62,
          "cut_pause_seconds": 0.32,
          "in_band": true
        },
        {
          "beat_id": "b054",
          "section_id": "s9",
          "word_start": 53,
          "word_end": 64,
          "text": "B\u1ed9 x\u01b0\u01a1ng r\u0103ng s\u00e2u l\u00fac n\u00e3y ch\u00ednh l\u00e0 c\u00e1i gi\u00e1 \u0111\u00f3.",
          "start_seconds": 108.217,
          "end_seconds": 110.537,
          "hold_seconds": 2.32,
          "cut_pause_seconds": 0.46,
          "in_band": true
        },
        {
          "beat_id": "b055",
          "section_id": "s9",
          "word_start": 64,
          "word_end": 73,
          "text": "V\u00ec th\u1ebf th\u1eddi gian c\u1ee7a b\u1ea1n kh\u00f4ng b\u1ecb c\u01b0\u1edbp,",
          "start_seconds": 110.537,
          "end_seconds": 112.297,
          "hold_seconds": 1.76,
          "cut_pause_seconds": 0.3,
          "in_band": true
        },
        {
          "beat_id": "b056",
          "section_id": "s9",
          "word_start": 73,
          "word_end": 81,
          "text": "n\u00f3 b\u1ecb \u0111\u1ed5i d\u1ea7n, t\u1eebng th\u1ebf h\u1ec7 m\u1ed9t.",
          "start_seconds": 112.297,
          "end_seconds": 114.623,
          "hold_seconds": 2.326,
          "cut_pause_seconds": null,
          "in_band": true
        },
        {
          "beat_id": "b057",
          "section_id": "s10",
          "word_start": 0,
          "word_end": 9,
          "text": "C\u1ea3 \u0111\u1eddi b\u1ea1n l\u00e0m vi\u1ec7c ch\u00edn m\u01b0\u01a1i ngh\u00ecn gi\u1edd,",
          "start_seconds": 114.623,
          "end_seconds": 116.513,
          "hold_seconds": 1.89,
          "cut_pause_seconds": 0.42,
          "in_band": true
        },
        {
          "beat_id": "b058",
          "section_id": "s10",
          "word_start": 9,
          "word_end": 17,
          "text": "mong ngh\u1ec9 h\u01b0u \u0111\u1ec3 c\u00f3 l\u1ea1i th\u1eddi gian.",
          "start_seconds": 116.513,
          "end_seconds": 118.133,
          "hold_seconds": 1.62,
          "cut_pause_seconds": 0.36,
          "in_band": true
        },
        {
          "beat_id": "b059",
          "section_id": "s10",
          "word_start": 17,
          "word_end": 26,
          "text": "C\u00f2n h\u1ecd, sinh ra \u0111\u00e3 \u0111\u1ee9ng \u1edf v\u1ea1ch \u0111\u00edch.",
          "start_seconds": 118.133,
          "end_seconds": 120.113,
          "hold_seconds": 1.98,
          "cut_pause_seconds": 0.4,
          "in_band": true
        },
        {
          "beat_id": "b060",
          "section_id": "s10",
          "word_start": 26,
          "word_end": 34,
          "text": "V\u1eady s\u00e1ng mai, khi c\u00e1i m\u00e1y l\u1ea1i h\u00e9t,",
          "start_seconds": 120.113,
          "end_seconds": 121.993,
          "hold_seconds": 1.88,
          "cut_pause_seconds": 0.32,
          "in_band": true
        },
        {
          "beat_id": "b061",
          "section_id": "s10",
          "word_start": 34,
          "word_end": 40,
          "text": "b\u1ea1n s\u1ebd h\u1ecfi m\u00ecnh c\u00e2u g\u00ec?",
          "start_seconds": 121.993,
          "end_seconds": 123.313,
          "hold_seconds": 1.32,
          "cut_pause_seconds": 0.42,
